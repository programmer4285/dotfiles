PLUGIN_DIR="$CONFIG_DIR/plugins"

source "$CONFIG_DIR/colors.sh"

# see: https://felixkratz.github.io/SketchyBar/config/bar
sketchybar --bar \
  color=$BASE \
  blur_radius=20 \
  height=35


# see: https://felixkratz.github.io/SketchyBar/config/items
default=(
  padding_left=5
  padding_right=5
  icon.font="FiraMono Nerd Font Mono:Bold:17.0"
  label.font="FiraMono Nerd Font Mono:Bold:14.0"
  icon.color="${SUBTEXT}"
  label.color="${SUBTEXT}"
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=4
)
sketchybar --default "${default[@]}"

# clock
sketchybar --add item clock right
sketchybar --set clock \
  update_freq=10 \
  icon="" \
  script="$PLUGIN_DIR/clock.sh"

# volume
sketchybar --add item volume right
sketchybar --set volume \
  script="$PLUGIN_DIR/volume.sh"
sketchybar --subscribe volume volume_change

# battery
sketchybar --add item battery right
sketchybar --set battery \
  update_freq=120 \
  script="$PLUGIN_DIR/battery.sh"
sketchybar --subscribe battery system_woke power_source_change

# hostname
sketchybar --add item hostname left
sketchybar --set hostname icon="" label="$(whoami)"

# workspaces
sketchybar --add event aerospace_workspace_change

get_ws_icon() {
    case "$1" in
        1) printf "" ;; # Browser
        2) printf "" ;; # Terminal
        3) printf "" ;; # Music
        # 2) printf "" ;; # IDE
        # 3) printf "" ;; # Testing
        # 5) printf "" ;; # Communication
        *) printf "" ;;
    esac
}

for sid in $(aerospace list-workspaces --all); do
    sicon=$(get_ws_icon "${sid}")

    sketchybar --add item "workspace.${sid}" left
    sketchybar --subscribe "workspace.${sid}" aerospace_workspace_change
    sketchybar --set "workspace.${sid}" \
        background.corner_radius=5 \
        background.height=20 \
        background.color="${BASE}" \
        background.drawing=off \
        label.color="${SUBTEXT}" \
        label="${sid}: ${sicon}" \
        click_script="aerospace workspace $sid" \
        script="${PLUGIN_DIR}/aerospace.sh ${sid}"
done

# system info
# sketchybar --add item cpu right \
#            --set cpu update_freq=5 script="$PLUGIN_DIR/cpu.sh"
#
# sketchybar --add item memory right \
#            --set memory update_freq=5 script="$PLUGIN_DIR/memory.sh"

# spotify
sketchybar --add item spotify right \
           --set spotify script="$PLUGIN_DIR/spotify.sh" \
                         update_freq=5 \
                         label.max_chars=15 \
                         scroll_texts=on \
                         label.align=center \
                         icon="" \
                         icon.color=${GREEN} \
           --subscribe spotify media_change


# Force all scripts to run the first time (never do this in a script)
sketchybar --update
